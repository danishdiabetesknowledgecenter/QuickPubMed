### General variables
VITE_ABOUT_AI_URL="/../om-nempubmed"
VITE_CLIENT_NAME=""

### Variables for NLM (only myncbishare needed - API key is handled server-side)
VITE_MY_NCBI_SHARE=""

### Variables for API Proxy (handles backend API calls)
# Local dev default: Vite serves the browser on 5173 and proxies /backend
# to the loopback-only PHP server (e.g. php -S 127.0.0.1:8080 -t . scripts/local-php-router.php).
VITE_API_PROXY_URL="/backend"
VITE_BACKEND_PROXY_TARGET="http://127.0.0.1:8080"

### Backend API keys used by the local PHP task
# Optional, but recommended. Without it Semantic Scholar often returns HTTP 429.
# Apply for a key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=""

VITE_DOMAIN=""
VITE_USE_AI="true"
VITE_USE_AI_SUMMARIZER="true"
VITE_LONG_ABSTRACT_LENGTH_LIMIT="5000"
VITE_WAIT_TIME_DISCLAIMER_DELAY="5000"
VITE_RUNTIME_CONTENT_CACHE_TTL_MS="300000"
VITE_THEME_CACHE_TTL_MS="300000"

### Mesh/NLM tuning (performance and resilience)
VITE_MESH_NLM_TIMEOUT_MS="10000"
VITE_MESH_NLM_RETRY_ATTEMPTS="2"
VITE_MESH_VALIDATION_CONCURRENCY="2"
VITE_MESH_VALIDATION_CACHE_LIMIT="500"
VITE_MESH_VALIDATION_CACHE_TTL_MS="900000"
